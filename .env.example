# Quick Scheduling — Phase 1 backend config.
# Copy to .env and fill in. Never commit a real .env.
# (DATABASE_URL is NOT needed for PGlite — data persists to ./data/pgdata below.
#  Only set DATABASE_URL if you swap src/db.ts to a `pg` Pool for production Postgres.)

# Where PGlite stores its data files, relative to the app directory.
PGDATA_DIR=./data/pgdata

# Long random string for signing session cookies. REQUIRED in production;
# leaving it unset logs a warning and uses an insecure dev default.
SESSION_SECRET=

# Port the server listens on.
PORT=3000

# true/false. DEV_MODE=true enables GET /api/auth/password-reset/dev-token
# (password-reset testing without email) — NEVER enable in production.
DEV_MODE=false

# development | production. Session cookie `secure` flag is true only when production.
NODE_ENV=development

# SMTP email (for team-member invite emails; password-reset emails later).
# Current provider: Gmail SMTP (temporary — Resend is the planned long-term provider).
# Resend API key for transactional email (invite emails). Get one at resend.com.
# When RESEND_API_KEY is unset, the app runs fine but
# POST /api/users/:id/send-invite returns 503 and the UI falls back to the
# manual copy-link flow.
RESEND_API_KEY=
# From address, e.g. "Quick Scheduling <noreply@yourdomain.com>".
# Until you verify a domain in Resend, leave this unset to use Resend's test sender.
RESEND_FROM=
